# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data (raw downloads and local DuckDB are local-only).
# Ignore contents, not the directory itself, so .gitkeep exceptions work.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep


# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Ledger / runtime
*.sqlite
*.sqlite3
runs/
briefs/
